[req]
default_bits       = 2048
prompt              = no
default_md          = sha256
distinguished_name  = dn
x509_extensions     = v3_req

[dn]
C  = ID
ST = Jawa Barat
L  = Bandung
O  = EKUITAS HRIS
CN = 10.31.101.80

[v3_req]
keyUsage = keyEncipherment, dataEncipherment
extendedKeyUsage = serverAuth
subjectAltName = @alt_names

[alt_names]
DNS.1 = localhost
IP.1  = 127.0.0.1
IP.2  = 10.31.101.80
